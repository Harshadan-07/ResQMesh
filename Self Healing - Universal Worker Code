#include <SPI.h>
#include <LoRa.h>

// =====================================================
// RESQMESH PHASE 4.1
// UNIVERSAL WORKER
// W1 / W2 / W3
// =====================================================

// ---------------- CHANGE THESE ----------------
#define NODE_ID "W1"
#define RELAY1 "W2"
#define RELAY2 "W3"
#define PERMANENT_NODE "P1"
// ----------------------------------------------

#define LORA_SCK   14
#define LORA_MISO  12
#define LORA_MOSI  13
#define LORA_SS    15
#define LORA_RST   17
#define LORA_DIO0  4

#define LORA_BAND 865E6

#define ACK_TIMEOUT 3000
#define MAX_RETRIES 3
#define OWN_MESSAGE_INTERVAL 15000

unsigned long lastOwnMessageTime = 0;
int sequenceNumber = 0;


// =====================================================
// RELAY QUEUE
// =====================================================

#define MAX_QUEUE 10

struct Packet {
  String source;
  String packetID;
  String payload;
};

Packet relayQueue[MAX_QUEUE];
int queueCount = 0;


// =====================================================
// GET FIELD
// =====================================================

String getField(String message, String field) {

  int start = message.indexOf(field);

  if (start == -1) return "";

  start += field.length();

  int end = message.indexOf("|", start);

  if (end == -1) end = message.length();

  return message.substring(start, end);
}


// =====================================================
// CHECK DUPLICATE
// =====================================================

bool packetAlreadyStored(String source, String packetID) {

  for (int i = 0; i < queueCount; i++) {

    if (
      relayQueue[i].source == source &&
      relayQueue[i].packetID == packetID
    ) {
      return true;
    }
  }

  return false;
}


// =====================================================
// STORE PACKET
// =====================================================

bool storePacket(
  String source,
  String packetID,
  String payload
) {

  if (packetAlreadyStored(source, packetID)) {

    Serial.println("DUPLICATE PACKET - ALREADY STORED");

    return true;
  }

  if (queueCount >= MAX_QUEUE) {

    Serial.println("QUEUE FULL!");

    return false;
  }

  relayQueue[queueCount].source = source;
  relayQueue[queueCount].packetID = packetID;
  relayQueue[queueCount].payload = payload;

  queueCount++;

  Serial.print("PACKET STORED. QUEUE: ");
  Serial.println(queueCount);

  return true;
}


// =====================================================
// REMOVE FIRST PACKET
// =====================================================

void removeFirstPacket() {

  if (queueCount == 0) return;

  for (int i = 0; i < queueCount - 1; i++) {
    relayQueue[i] = relayQueue[i + 1];
  }

  queueCount--;
}


// =====================================================
// LORA SETUP
// =====================================================

void setupLoRa() {

  SPI.begin(
    LORA_SCK,
    LORA_MISO,
    LORA_MOSI,
    LORA_SS
  );

  LoRa.setPins(
    LORA_SS,
    LORA_RST,
    LORA_DIO0
  );

  if (!LoRa.begin(LORA_BAND)) {

    Serial.println("LoRa FAILED!");

    while (true);
  }

  LoRa.setSpreadingFactor(7);
  LoRa.setSignalBandwidth(125E3);
  LoRa.setCodingRate4(5);
  LoRa.setSyncWord(0x12);
  LoRa.enableCrc();

  LoRa.receive();

  Serial.println("LoRa READY");
}


// =====================================================
// SEND RAW
// =====================================================

void sendRawPacket(String packet) {

  LoRa.idle();

  LoRa.beginPacket();
  LoRa.print(packet);
  LoRa.endPacket();

  LoRa.receive();
}


// =====================================================
// SEND ACK
// =====================================================

void sendACK(
  String destination,
  String packetID
) {

  String ack =
    "ACK|FROM:" +
    String(NODE_ID) +
    "|TO:" +
    destination +
    "|ID:" +
    packetID;

  sendRawPacket(ack);

  Serial.print("ACK SENT TO: ");
  Serial.println(destination);
}


// =====================================================
// HANDLE INCOMING DATA
// =====================================================

void handleDataPacket(String received) {

  String destination = getField(received, "DEST:");

  if (destination != NODE_ID) return;

  String source = getField(received, "SRC:");
  String sender = getField(received, "FROM:");
  String packetID = getField(received, "ID:");
  String payload = getField(received, "MSG:");

  Serial.println();
  Serial.println("========== INCOMING RELAY ==========");
  Serial.print("SOURCE: ");
  Serial.println(source);

  Serial.print("FROM: ");
  Serial.println(sender);

  Serial.print("ID: ");
  Serial.println(packetID);

  Serial.print("MESSAGE: ");
  Serial.println(payload);

  bool stored = storePacket(
    source,
    packetID,
    payload
  );

  if (stored) {
    sendACK(sender, packetID);
  }
}


// =====================================================
// WAIT FOR ACK
// =====================================================

bool waitForACK(
  String expectedFrom,
  String expectedID
) {

  unsigned long startTime = millis();

  while (millis() - startTime < ACK_TIMEOUT) {

    int packetSize = LoRa.parsePacket();

    if (!packetSize) {
      delay(5);
      continue;
    }

    String received = "";

    while (LoRa.available()) {
      received += (char)LoRa.read();
    }

    if (received.startsWith("ACK")) {

      String from = getField(received, "FROM:");
      String to = getField(received, "TO:");
      String id = getField(received, "ID:");

      if (
        from == expectedFrom &&
        to == NODE_ID &&
        id == expectedID
      ) {

        Serial.println("ACK SUCCESS");

        return true;
      }
    }

    else if (received.startsWith("DATA")) {

      handleDataPacket(received);
    }
  }

  return false;
}


// =====================================================
// SEND WITH RETRY
// =====================================================

bool sendWithRetry(
  String packet,
  String destination,
  String packetID
) {

  for (
    int attempt = 1;
    attempt <= MAX_RETRIES;
    attempt++
  ) {

    Serial.println();

    Serial.print("SEND TO: ");
    Serial.println(destination);

    Serial.print("ATTEMPT: ");
    Serial.print(attempt);
    Serial.print("/");
    Serial.println(MAX_RETRIES);

    sendRawPacket(packet);

    Serial.println("WAITING FOR ACK...");

    if (
      waitForACK(
        destination,
        packetID
      )
    ) {
      return true;
    }

    Serial.println("ACK FAILED");

    delay(300);
  }

  return false;
}


// =====================================================
// CREATE AND SEND OWN MESSAGE
//
// ROUTE:
// MAIN -> RELAY1 -> RELAY2 -> P1
// =====================================================

void sendOwnMessage() {

  sequenceNumber++;

  String packetID =
    String(NODE_ID) +
    "_" +
    String(sequenceNumber);

  String payload =
    "MESSAGE_FROM_" +
    String(NODE_ID) +
    "_" +
    String(sequenceNumber);

  Serial.println();
  Serial.println("================================");
  Serial.println("OWN MESSAGE CREATED");
  Serial.print("NODE: ");
  Serial.println(NODE_ID);
  Serial.print("ID: ");
  Serial.println(packetID);
  Serial.println("================================");


  // -------------------------------------------------
  // ROUTE 1 - MAIN
  // -------------------------------------------------

  String packetToMain =
    "DATA|SRC:" +
    String(NODE_ID) +
    "|FROM:" +
    String(NODE_ID) +
    "|DEST:MAIN|ID:" +
    packetID +
    "|MSG:" +
    payload;

  Serial.println("TRYING MAIN");

  if (
    sendWithRetry(
      packetToMain,
      "MAIN",
      packetID
    )
  ) {

    Serial.println("DIRECT DELIVERY SUCCESS");

    return;
  }


  // -------------------------------------------------
  // ROUTE 2 - RELAY1
  // -------------------------------------------------

  String packetToRelay1 =
    "DATA|SRC:" +
    String(NODE_ID) +
    "|FROM:" +
    String(NODE_ID) +
    "|DEST:" +
    String(RELAY1) +
    "|ID:" +
    packetID +
    "|MSG:" +
    payload;

  Serial.print("MAIN FAILED -> TRYING ");
  Serial.println(RELAY1);

  if (
    sendWithRetry(
      packetToRelay1,
      RELAY1,
      packetID
    )
  ) {

    Serial.println("RELAY1 STORED MESSAGE");

    return;
  }


  // -------------------------------------------------
  // ROUTE 3 - RELAY2
  // -------------------------------------------------

  String packetToRelay2 =
    "DATA|SRC:" +
    String(NODE_ID) +
    "|FROM:" +
    String(NODE_ID) +
    "|DEST:" +
    String(RELAY2) +
    "|ID:" +
    packetID +
    "|MSG:" +
    payload;

  Serial.print("RELAY1 FAILED -> TRYING ");
  Serial.println(RELAY2);

  if (
    sendWithRetry(
      packetToRelay2,
      RELAY2,
      packetID
    )
  ) {

    Serial.println("RELAY2 STORED MESSAGE");

    return;
  }


  // -------------------------------------------------
  // ROUTE 4 - PERMANENT NODE P1
  // -------------------------------------------------

  String packetToP1 =
    "DATA|SRC:" +
    String(NODE_ID) +
    "|FROM:" +
    String(NODE_ID) +
    "|DEST:" +
    String(PERMANENT_NODE) +
    "|ID:" +
    packetID +
    "|MSG:" +
    payload;

  Serial.print("ALL WORKERS FAILED -> TRYING ");
  Serial.println(PERMANENT_NODE);

  if (
    sendWithRetry(
      packetToP1,
      PERMANENT_NODE,
      packetID
    )
  ) {

    Serial.println("P1 STORED MESSAGE");

    return;
  }


  Serial.println();
  Serial.println("ALL ROUTES FAILED!");
  Serial.println("MESSAGE NOT DELIVERED");
}


// =====================================================
// FORWARD STORED PACKETS
// =====================================================

void forwardStoredPackets() {

  while (queueCount > 0) {

    String source =
      relayQueue[0].source;

    String packetID =
      relayQueue[0].packetID;

    String payload =
      relayQueue[0].payload;


    Serial.println();
    Serial.println("FORWARDING RELAY PACKET");

    String forwardPacket =
      "DATA|SRC:" +
      source +
      "|FROM:" +
      String(NODE_ID) +
      "|DEST:MAIN|ID:" +
      packetID +
      "|MSG:" +
      payload;


    if (
      sendWithRetry(
        forwardPacket,
        "MAIN",
        packetID
      )
    ) {

      Serial.println("FORWARD SUCCESS");

      removeFirstPacket();

    } else {

      Serial.println("MAIN UNREACHABLE");
      Serial.println("KEEPING PACKET IN QUEUE");

      break;
    }
  }
}


// =====================================================
// CHECK INCOMING
// =====================================================

void checkIncoming() {

  int packetSize = LoRa.parsePacket();

  if (!packetSize) return;

  String received = "";

  while (LoRa.available()) {
    received += (char)LoRa.read();
  }

  if (received.startsWith("DATA")) {
    handleDataPacket(received);
  }
}


// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(115200);

  delay(2000);

  Serial.println();
  Serial.println("================================");
  Serial.println("RESQMESH UNIVERSAL WORKER");
  Serial.print("NODE: ");
  Serial.println(NODE_ID);
  Serial.println("================================");

  setupLoRa();
}


// =====================================================
// LOOP
// =====================================================

void loop() {

  // Listen continuously
  checkIncoming();


  // Periodically create own message
  if (
    millis() - lastOwnMessageTime >=
    OWN_MESSAGE_INTERVAL
  ) {

    lastOwnMessageTime = millis();

    // Own message has priority
    sendOwnMessage();

    // Then forward relay messages
    forwardStoredPackets();
  }

  delay(10);
}
